     }
    },
    "items": {
     "type": "array",
     "maxItems": 3000,
     "items": {
      "$ref": "pack_item"
     }
    },
    "groups": {
     "type": "array",
     "maxItems": 500,
     "items": {
      "$ref": "pack_group"
     }
    }
   }
  },
