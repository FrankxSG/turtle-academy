    "version",
    "status",
    "curriculum_manifest_version",
    "materials",
    "items",
    "groups"
   ],
   "properties": {
    "batch_id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "status": {
