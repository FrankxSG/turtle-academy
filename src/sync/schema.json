{
 "id": "pilot-sync/1",
 "note": "Closed allow-list for live-sync uploads (Pilot Scope section 3; Learning Engine section 6). One operation per committed local change; every object is closed, so unknown keys, wrong forms (the pack case `observed`), item/material `rationale` and `provenance`, the parent PIN/hash, worksheets, copied source questions, school/teacher details and device-only metadata are rejected. Practice text is bounded per field; descriptive pack fields are short single-line text. Stages, due dates and unlocks are never uploaded. The same descriptor is embedded in the database migration and parity-tested.",
 "limits": {
  "op_bytes": 1572864,
  "request_bytes": 2097152,
  "ops_per_request": 50,
  "changes_per_op": 2000,
  "pull_page": 500
 },
 "defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
  },
  "nullable_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$",
   "nullable": true
  },
  "token": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,47}$"
  },
  "nullable_token": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,47}$",
   "nullable": true
  },
  "uuid": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "nullable_uuid": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
   "nullable": true
  },
  "date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "nullable_date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
   "nullable": true
  },
  "datetime": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
  },
  "nullable_datetime": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
   "nullable": true
  },
  "timezone": {
   "type": "string",
   "pattern": "^[A-Za-z_]{1,32}(/[A-Za-z0-9_+-]{1,32}){0,2}$"
  },
  "subject": {
   "type": "string",
   "enum": [
    "chinese",
    "english",
    "mathematics",
    "science"
   ]
  },
  "course": {
   "type": "string",
   "enum": [
    "p2_chinese",
    "p2_higher_chinese",
    "p3_chinese",
    "p3_higher_chinese",
    "p2_english",
    "p3_english",
    "p2_mathematics",
    "p3_science"
   ]
  },
  "count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 100000
  },
  "position": {
   "type": "integer",
   "minimum": 0,
   "maximum": 200
  },
  "item_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "nullable_item_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000,
   "nullable": true
  },
  "x": {
   "type": "integer",
   "minimum": 6,
   "maximum": 20
  },
  "stage": {
   "type": "string",
   "enum": [
    "acquisition",
    "exact",
    "similar",
    "generic",
    "delayed_review"
   ]
  },
  "nullable_stage": {
   "type": "string",
   "enum": [
    "acquisition",
    "exact",
    "similar",
    "generic",
    "delayed_review"
   ],
   "nullable": true
  },
  "role": {
   "type": "string",
   "enum": [
    "material_question",
    "repair",
    "delayed_review",
    "general_practice",
    "acquisition_test",
    "replacement"
   ]
  },
  "format_class": {
   "type": "string",
   "enum": [
    "high_option",
    "low_option"
   ]
  },
  "id_list": {
   "type": "array",
   "maxItems": 60,
   "items": {
    "$ref": "id"
   }
  },
  "stamp": {
   "type": "object",
   "required": [
    "t",
    "c",
    "d"
   ],
   "properties": {
    "t": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9999999999999
    },
    "c": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000000
    },
    "d": {
     "$ref": "uuid"
    }
   }
  },
  "short_text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 48,
   "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
   "notPattern": "(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
  },
  "case_text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 80,
   "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
   "notPattern": "(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
  },
  "pack_token": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
  },
  "plan_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,160}$"
  },
  "option_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$"
  },
  "pack_course": {
   "type": "string",
   "enum": [
    "p2_chinese",
    "p2_higher_chinese",
    "p3_chinese",
    "p3_higher_chinese"
   ]
  },
  "pack_courses": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "$ref": "pack_course"
   }
  },
  "ref_list": {
   "type": "array",
   "maxItems": 64,
   "items": {
    "$ref": "id"
   }
  },
  "prompt": {
   "type": "string",
   "maxLength": 400,
   "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
   "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
  },
  "blanks": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "type": "object",
    "required": [
     "id",
     "question_id"
    ],
    "properties": {
     "id": {
      "$ref": "option_id"
     },
     "question_id": {
      "$ref": "id"
     }
    }
   }
  },
  "annotations": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "type": "object",
    "required": [
     "id",
     "text",
     "pinyin"
    ],
    "properties": {
     "id": {
      "$ref": "option_id"
     },
     "text": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
      "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
     },
     "pinyin": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
      "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
     }
    }
   }
  },
  "plan": {
   "type": "object",
   "required": [
    "id",
    "mode",
    "stages",
    "success_rule"
   ],
   "properties": {
    "id": {
     "$ref": "plan_id"
    },
    "mode": {
     "type": "string",
     "enum": [
      "external_writing",
      "external_speaking"
     ]
    },
    "stages": {
     "type": "object",
     "required": [
      "exact",
      "similar",
      "generic"
     ],
     "properties": {
      "exact": {
       "type": "object",
       "required": [
        "prompt",
        "verification",
        "automatically_scored"
       ],
       "properties": {
        "prompt": {
         "$ref": "prompt"
        },
        "verification": {
         "type": "string",
         "enum": [
          "parent_observation"
         ]
        },
        "automatically_scored": {
         "type": "boolean",
         "enum": [
          false
         ]
        }
       }
      },
      "similar": {
       "type": "object",
       "required": [
        "prompt",
        "verification",
        "automatically_scored"
       ],
       "properties": {
        "prompt": {
         "$ref": "prompt"
        },
        "verification": {
         "type": "string",
         "enum": [
          "parent_observation"
         ]
        },
        "automatically_scored": {
         "type": "boolean",
         "enum": [
          false
         ]
        }
       }
      },
      "generic": {
       "type": "object",
       "required": [
        "prompt",
        "verification",
        "automatically_scored"
       ],
       "properties": {
        "prompt": {
         "$ref": "prompt"
        },
        "verification": {
         "type": "string",
         "enum": [
          "parent_observation"
         ]
        },
        "automatically_scored": {
         "type": "boolean",
         "enum": [
          false
         ]
        }
       }
      }
     }
    },
    "success_rule": {
     "type": "string",
     "maxLength": 1200,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    }
   }
  },
  "pins": {
   "type": "array",
   "maxItems": 200,
   "items": {
    "type": "object",
    "required": [
     "item_id",
     "version"
    ],
    "properties": {
     "item_id": {
      "$ref": "id"
     },
     "version": {
      "$ref": "item_version"
     }
    }
   }
  },
  "objective_route": {
   "type": "object",
   "required": [
    "mode",
    "progress_target_ref",
    "batch_id",
    "batch_version",
    "content_state",
    "stages",
    "ready_for_runtime"
   ],
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "objective"
     ]
    },
    "progress_target_ref": {
     "$ref": "id"
    },
    "batch_id": {
     "$ref": "id"
    },
    "batch_version": {
     "$ref": "item_version"
    },
    "content_state": {
     "$ref": "pack_token"
    },
    "stages": {
     "type": "object",
     "required": [
      "exact",
      "similar",
      "generic"
     ],
     "properties": {
      "exact": {
       "$ref": "pins"
      },
      "similar": {
       "$ref": "pins"
      },
      "generic": {
       "$ref": "pins"
      }
     }
    },
    "ready_for_runtime": {
     "type": "boolean"
    }
   }
  },
  "external_route": {
   "type": "object",
   "required": [
    "mode",
    "plan"
   ],
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "external"
     ]
    },
    "plan": {
     "$ref": "plan"
    }
   }
  },
  "register_case": {
   "type": "object",
   "required": [
    "id",
    "target",
    "observation_type",
    "review_status",
    "cause",
    "source_interpretation_uncertain",
    "correction_status",
    "route"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^O[0-9]{3}$"
    },
    "target": {
     "$ref": "case_text"
    },
    "observation_type": {
     "type": "string",
     "enum": [
      "character",
      "word",
      "pinyin",
      "reading",
      "writing",
      "speaking"
     ]
    },
    "review_status": {
     "type": "string",
     "enum": [
      "parent_accepted"
     ]
    },
    "cause": {
     "$ref": "short_text"
    },
    "source_interpretation_uncertain": {
     "type": "boolean"
    },
    "correction_status": {
     "$ref": "short_text"
    },
    "route": {
     "anyOf": [
      {
       "$ref": "objective_route"
      },
      {
       "$ref": "external_route"
      }
     ]
    },
    "production_followup": {
     "$ref": "plan"
    }
   }
  },
  "pack_item": {
   "type": "object",
   "required": [
    "id",
    "version",
    "courses",
    "target_refs",
    "family",
    "format",
    "stem",
    "options",
    "correct_option_id",
    "hint",
    "explanation",
    "material_id",
    "stage",
    "blanks",
    "annotations",
    "blank_ref"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "courses": {
     "$ref": "pack_courses"
    },
    "outcome_refs": {
     "$ref": "ref_list"
    },
    "target_refs": {
     "$ref": "ref_list"
    },
    "repair_target_refs": {
     "type": "array",
     "nullable": true,
     "maxItems": 64,
     "items": {
      "$ref": "id"
     }
    },
    "family": {
     "$ref": "pack_token"
    },
    "format": {
     "type": "string",
     "enum": [
      "mcq_4plus"
     ]
    },
    "stem": {
     "type": "string",
     "maxLength": 600,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "options": {
     "type": "array",
     "maxItems": 12,
     "items": {
      "type": "object",
      "required": [
       "id",
       "text"
      ],
      "properties": {
       "id": {
        "$ref": "option_id"
       },
       "text": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
        "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
       }
      }
     }
    },
    "correct_option_id": {
     "$ref": "option_id"
    },
    "hint": {
     "type": "string",
     "maxLength": 400,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "explanation": {
     "type": "string",
     "maxLength": 800,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "material_id": {
     "$ref": "nullable_id"
    },
    "stage": {
     "type": "string",
     "nullable": true,
     "enum": [
      "exact",
      "similar",
      "generic"
     ]
    },
    "asset_refs": {
     "$ref": "ref_list"
    },
    "blanks": {
     "$ref": "blanks"
    },
    "annotations": {
     "$ref": "annotations"
    },
    "blank_ref": {
     "type": "string",
     "nullable": true,
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$"
    }
   }
  },
  "pack_material": {
   "type": "object",
   "required": [
    "id",
    "version",
    "courses",
    "kind",
    "title",
    "body",
    "question_ids",
    "blanks",
    "annotations"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "courses": {
     "$ref": "pack_courses"
    },
    "kind": {
     "$ref": "pack_token"
    },
    "title": {
     "type": "string",
     "maxLength": 120,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "body": {
     "type": "string",
     "maxLength": 4000,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "question_ids": {
     "$ref": "ref_list"
    },
    "blanks": {
     "$ref": "blanks"
    },
    "annotations": {
     "$ref": "annotations"
    },
    "outcome_refs": {
     "$ref": "ref_list"
    },
    "asset_refs": {
     "$ref": "ref_list"
    }
   }
  },
  "pack_group": {
   "type": "object",
   "required": [
    "id",
    "target_refs",
    "item_ids"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "label_zh": {
     "type": "string",
     "maxLength": 64,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "label_en": {
     "type": "string",
     "maxLength": 120,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "courses": {
     "$ref": "pack_courses"
    },
    "target_refs": {
     "type": "array",
     "maxItems": 400,
     "items": {
      "$ref": "id"
     }
    },
    "item_ids": {
     "type": "array",
     "maxItems": 1000,
     "items": {
      "$ref": "id"
     }
    }
   }
  },
  "pack_batch": {
   "type": "object",
   "required": [
