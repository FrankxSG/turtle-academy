   }
  },
  "active_pack": {
   "class": "editable",
   "key": "active",
   "value": {
    "type": "object",
    "required": [
     "version_ref"
    ],
    "properties": {
     "version_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}@[0-9a-f]{16}$"
     }
    }
   }
  },
  "case_link": {
   "class": "editable",
   "key": "case_id",
   "deletable": true,
   "value": {
    "type": "object",
    "required": [
     "case_id",
     "mode",
     "target_ref",
     "engine_target_id",
     "plan_id",
     "shared_with"
    ],
    "properties": {
     "case_id": {
      "type": "string",
      "pattern": "^O[0-9]{3}$"
     },
     "mode": {
      "type": "string",
      "enum": [
       "objective",
       "external"
      ]
     },
     "target_ref": {
      "$ref": "nullable_id"
     },
     "engine_target_id": {
      "$ref": "nullable_id"
     },
     "plan_id": {
      "type": "string",
      "nullable": true,
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,160}$"
     },
     "shared_with": {
      "type": "array",
      "maxItems": 2000,
      "items": {
       "type": "string",
       "pattern": "^O[0-9]{3}$"
      }
     }
    }
   }
  },
  "production_event": {
   "class": "add_only",
   "key": "id",
   "value": {
    "type": "object",
    "required": [
     "id",
     "plan_id",
     "stage",
     "observed_on",
     "mode",
     "result",
     "recorded_at"
    ],
    "properties": {
     "id": {
      "$ref": "id"
     },
     "plan_id": {
      "$ref": "plan_id"
     },
     "stage": {
      "type": "string",
      "enum": [
       "exact",
       "similar",
       "generic",
       "delayed_review"
      ]
     },
     "observed_on": {
      "$ref": "date"
     },
     "mode": {
      "type": "string",
      "enum": [
       "independent",
       "supported"
      ]
     },
     "result": {
      "type": "string",
      "enum": [
       "correct",
       "not_yet"
      ]
     },
     "recorded_at": {
      "$ref": "datetime"
     }
    }
   }
  }
 }
}
