     },
     "x": {
      "$ref": "x"
     },
     "policy_version": {
      "$ref": "id"
     },
     "content_version": {
      "$ref": "id"
     },
     "status": {
      "type": "string",
      "enum": [
       "active",
       "paused",
       "finalised"
      ]
     },
     "plan": {
      "type": "object",
      "required": [
       "materials",
       "slots"
      ],
      "properties": {
       "materials": {
        "type": "array",
        "maxItems": 8,
        "items": {
         "type": "object",
         "required": [
          "material_ref",
          "material_version",
          "family",
          "question_count"
         ],
         "properties": {
          "material_ref": {
           "$ref": "id"
          },
          "material_version": {
           "$ref": "item_version"
          },
          "family": {
           "$ref": "token"
          },
          "question_count": {
           "type": "integer",
           "minimum": 1,
           "maximum": 40
          }
         }
        }
       },
       "slots": {
        "type": "array",
        "maxItems": 100,
        "items": {
         "type": "object",
         "required": [
          "position",
          "kind",
          "material_ref",
          "item_id",
          "item_version",
          "role",
          "target_ref",
          "stage",
          "counts_toward_x"
         ],
         "properties": {
          "position": {
           "$ref": "position"
          },
          "kind": {
           "type": "string",
           "enum": [
            "material_question",
            "short",
            "teaching"
           ]
          },
          "material_ref": {
           "$ref": "nullable_id"
          },
          "item_id": {
           "$ref": "nullable_id"
          },
          "item_version": {
           "$ref": "nullable_item_version"
          },
          "role": {
           "type": "string",
           "enum": [
            "material_question",
            "repair",
            "delayed_review",
            "general_practice",
            "acquisition_test",
            "replacement",
            "teaching"
           ]
          },
          "target_ref": {
           "$ref": "nullable_id"
          },
          "stage": {
           "$ref": "nullable_stage"
          },
          "counts_toward_x": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "planned_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
     },
     "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
     },
     "active_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
     },
     "activity": {
      "type": "array",
      "maxItems": 2000,
      "items": {
       "type": "object",
       "required": [
        "state",
        "at"
       ],
       "properties": {
        "state": {
         "type": "string",
         "enum": [
          "active",
          "paused",
          "backgrounded",
          "idle",
          "closed"
         ]
        },
        "at": {
         "$ref": "datetime"
        }
       }
      }
     },
     "target_aggregates": {
      "type": "array",
      "maxItems": 0
     }
    }
   }
  },
  "completion": {
   "class": "add_only",
   "key": "completion",
   "value": {
    "type": "object",
    "required": [
