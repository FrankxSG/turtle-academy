     "knowledge_point_ref",
     "target_value",
     "assessed_skill",
     "error_type",
     "mapping_status",
     "verification",
     "status",
     "verified_at",
     "replaces",
     "observations"
    ],
    "properties": {
     "id": {
      "$ref": "id"
     },
     "subject": {
      "$ref": "subject"
     },
     "course": {
      "$ref": "course"
     },
     "target_kind": {
      "type": "string",
      "enum": [
       "character",
       "word",
