{
 "id": "pilot-sync/1",
 "note": "Closed allow-list for live-sync uploads (Pilot Scope section 3; Learning Engine section 6). One operation per committed local change; every object is closed, so unknown keys, wrong forms (the pack case `observed`), item/material `rationale` and `provenance`, the parent PIN/hash, worksheets, copied source questions, school/teacher details and device-only metadata are rejected. Practice text is bounded per field; descriptive pack fields are short single-line text. Stages, due dates and unlocks are never uploaded. The same descriptor is embedded in the database migration and parity-tested.",
 "limits": {
  "op_bytes": 1572864,
  "request_bytes": 2097152,
  "ops_per_request": 50,
  "changes_per_op": 2000,
  "pull_page": 500
 },
 "defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
  },
  "nullable_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$",
   "nullable": true
  },
  "token": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,47}$"
  },
  "nullable_token": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,47}$",
   "nullable": true
  },
  "uuid": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "nullable_uuid": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
   "nullable": true
  },
  "date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "nullable_date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
   "nullable": true
  },
  "datetime": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
  },
  "nullable_datetime": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
   "nullable": true
  },
  "timezone": {
   "type": "string",
   "pattern": "^[A-Za-z_]{1,32}(/[A-Za-z0-9_+-]{1,32}){0,2}$"
  },
  "subject": {
   "type": "string",
   "enum": [
    "chinese",
    "english",
    "mathematics",
    "science"
   ]
  },
  "course": {
   "type": "string",
   "enum": [
    "p2_chinese",
    "p2_higher_chinese",
    "p3_chinese",
    "p3_higher_chinese",
    "p2_english",
    "p3_english",
    "p2_mathematics",
    "p3_science"
   ]
  },
  "count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 100000
  },
  "position": {
   "type": "integer",
   "minimum": 0,
   "maximum": 200
  },
  "item_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000
  },
  "nullable_item_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100000,
   "nullable": true
  },
  "x": {
   "type": "integer",
   "minimum": 6,
   "maximum": 20
  },
  "stage": {
   "type": "string",
   "enum": [
    "acquisition",
    "exact",
    "similar",
    "generic",
    "delayed_review"
   ]
  },
  "nullable_stage": {
   "type": "string",
   "enum": [
    "acquisition",
    "exact",
    "similar",
    "generic",
    "delayed_review"
   ],
   "nullable": true
  },
  "role": {
   "type": "string",
   "enum": [
    "material_question",
    "repair",
    "delayed_review",
    "general_practice",
    "acquisition_test",
    "replacement"
   ]
  },
  "format_class": {
   "type": "string",
   "enum": [
    "high_option",
    "low_option"
   ]
  },
  "id_list": {
   "type": "array",
   "maxItems": 60,
   "items": {
    "$ref": "id"
   }
  },
  "stamp": {
   "type": "object",
   "required": [
    "t",
    "c",
    "d"
   ],
   "properties": {
    "t": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9999999999999
    },
    "c": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000000
    },
    "d": {
     "$ref": "uuid"
    }
   }
  }
 },
 "operation": {
  "type": "object",
  "required": [
   "op_id",
   "device_id",
   "device_seq",
   "stamp",
   "changes"
  ],
  "properties": {
   "op_id": {
    "$ref": "uuid"
   },
   "device_id": {
    "$ref": "uuid"
   },
   "device_seq": {
    "type": "integer",
    "minimum": 1,
    "maximum": 9007199254740991
   },
   "stamp": {
    "$ref": "stamp"
   },
   "changes": {
    "type": "array",
    "maxItems": 2000,
    "items": {
     "type": "object",
     "required": [
      "kind",
      "key"
     ],
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "answer_event",
        "presentation",
        "task",
        "completion",
        "checkpoint",
        "story_state",
        "target",
        "amendment",
        "flag",
        "suspension",
        "exposure",
        "rest_day",
        "setting",
        "timezone_change",
        "guards",
        "content_version",
        "pack_version",
        "active_pack",
        "case_link",
        "production_event"
       ]
      },
      "key": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+*/-]{0,199}$"
      },
      "value": {
       "type": "object",
       "open": true
      },
      "deleted": {
       "type": "boolean",
       "enum": [
        true
       ]
      }
     }
    }
   }
  }
 },
 "kinds": {
  "answer_event": {
   "class": "add_only",
   "key": "id",
   "value": {
    "type": "object",
    "required": [
     "id",
     "presentation_id",
     "local_seq",
     "phase",
     "assistance",
     "response",
     "correct",
     "at"
    ],
    "properties": {
     "id": {
      "$ref": "id"
     },
     "presentation_id": {
      "$ref": "id"
     },
     "local_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
     },
     "phase": {
      "type": "string",
      "enum": [
       "first",
       "retry",
       "correction"
      ]
     },
     "assistance": {
      "type": "string",
      "enum": [
       "none",
       "hint",
       "worked_steps",
       "answer_and_explanation"
      ]
     },
     "response": {
      "type": "object",
      "required": [
       "kind",
       "option_ids",
       "pairs"
      ],
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "single",
         "ordered",
         "matching",
         "word_bank"
        ]
       },
       "option_ids": {
        "type": "array",
        "maxItems": 16,
        "items": {
         "$ref": "id"
        }
       },
       "pairs": {
        "type": "array",
        "maxItems": 16,
        "items": {
         "type": "object",
         "required": [
          "left",
          "right"
         ],
         "properties": {
          "left": {
           "$ref": "id"
          },
          "right": {
           "$ref": "id"
          }
         }
        }
       }
      }
     },
     "correct": {
      "type": "boolean"
     },
     "at": {
      "$ref": "datetime"
     }
    }
   }
  },
  "presentation": {
   "class": "presentation",
   "key": "id",
   "value": {
    "type": "object",
    "required": [
     "id",
     "task_id",
     "position",
     "item_id",
     "item_version",
     "role",
     "material_ref",
     "target_ref",
     "stage",
     "format_class",
     "first_response_eligible",
     "prior_exposures",
     "novel_context",
     "presented_at",
     "status"
    ],
    "properties": {
     "id": {
      "$ref": "id"
     },
     "task_id": {
      "$ref": "id"
     },
     "position": {
      "$ref": "position"
     },
     "item_id": {
      "$ref": "id"
     },
     "item_version": {
      "$ref": "item_version"
     },
     "role": {
      "$ref": "role"
     },
     "material_ref": {
      "$ref": "nullable_id"
     },
     "target_ref": {
      "$ref": "nullable_id"
     },
     "stage": {
      "$ref": "nullable_stage"
     },
     "format_class": {
      "$ref": "format_class"
     },
     "first_response_eligible": {
      "type": "boolean"
     },
     "prior_exposures": {
      "$ref": "count"
     },
     "novel_context": {
      "type": "boolean"
     },
     "presented_at": {
      "$ref": "datetime"
     },
     "status": {
      "type": "string",
      "enum": [
       "presented",
       "answered",
       "corrected",
       "flagged_replaced",
       "invalidated"
      ]
     }
    }
   }
  },
  "task": {
   "class": "task",
   "key": "id",
   "value": {
    "type": "object",
    "required": [
     "id",
     "subject",
     "local_date",
     "created_at",
     "finalised_at",
     "x",
     "policy_version",
     "content_version",
     "status",
     "plan",
     "planned_total",
     "cursor",
     "active_seconds",
     "activity",
     "target_aggregates"
    ],
    "properties": {
     "id": {
      "$ref": "id"
     },
     "subject": {
      "$ref": "subject"
     },
     "local_date": {
      "$ref": "date"
     },
     "created_at": {
      "$ref": "datetime"
     },
     "finalised_at": {
