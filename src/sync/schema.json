     "maxLength": 24,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    }
   }
  },
  "pack": {
   "type": "object",
   "required": [
    "schema_version",
    "pack_id",
    "course",
    "register",
    "corrective_batches",
    "private_targets"
   ],
   "properties": {
    "schema_version": {
     "type": "string",
     "enum": [
      "turtle-private-pack/1"
     ]
    },
    "pack_id": {
     "$ref": "id"
    },
    "course": {
