{
 "id": "pilot-sync/1#pack",
 "note": "Private mistake pack part of the pilot-sync/1 allow-list. Loaded only by the private build; merged into the server descriptor.",
 "defs": {
  "short_text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 48,
   "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
   "notPattern": "(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
  },
  "case_text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 80,
   "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
   "notPattern": "(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
  },
  "pack_token": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
  },
  "plan_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_.:-]{0,160}$"
  },
  "option_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$"
  },
  "pack_course": {
   "type": "string",
   "enum": [
    "p2_chinese",
    "p2_higher_chinese",
    "p3_chinese",
    "p3_higher_chinese"
   ]
  },
  "pack_courses": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "$ref": "pack_course"
   }
  },
  "ref_list": {
   "type": "array",
   "maxItems": 64,
   "items": {
    "$ref": "id"
   }
  },
  "prompt": {
   "type": "string",
   "maxLength": 400,
   "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
   "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
  },
  "blanks": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "type": "object",
    "required": [
     "id",
     "question_id"
    ],
    "properties": {
     "id": {
      "$ref": "option_id"
     },
     "question_id": {
      "$ref": "id"
     }
    }
   }
  },
  "annotations": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "type": "object",
    "required": [
     "id",
     "text",
     "pinyin"
    ],
    "properties": {
     "id": {
      "$ref": "option_id"
     },
     "text": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
      "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
     },
     "pinyin": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
      "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
     }
    }
   }
  },
  "plan": {
   "type": "object",
   "required": [
    "id",
    "mode",
    "stages",
    "success_rule"
   ],
   "properties": {
    "id": {
     "$ref": "plan_id"
    },
    "mode": {
     "type": "string",
     "enum": [
      "external_writing",
      "external_speaking"
     ]
    },
    "stages": {
     "type": "object",
     "required": [
      "exact",
      "similar",
      "generic"
     ],
     "properties": {
      "exact": {
       "type": "object",
       "required": [
        "prompt",
        "verification",
        "automatically_scored"
       ],
       "properties": {
        "prompt": {
         "$ref": "prompt"
        },
        "verification": {
         "type": "string",
         "enum": [
          "parent_observation"
         ]
        },
        "automatically_scored": {
         "type": "boolean",
         "enum": [
          false
         ]
        }
       }
      },
      "similar": {
       "type": "object",
       "required": [
        "prompt",
        "verification",
        "automatically_scored"
       ],
       "properties": {
        "prompt": {
         "$ref": "prompt"
        },
        "verification": {
         "type": "string",
         "enum": [
          "parent_observation"
         ]
        },
        "automatically_scored": {
         "type": "boolean",
         "enum": [
          false
         ]
        }
       }
      },
      "generic": {
       "type": "object",
       "required": [
        "prompt",
        "verification",
        "automatically_scored"
       ],
       "properties": {
        "prompt": {
         "$ref": "prompt"
        },
        "verification": {
         "type": "string",
         "enum": [
          "parent_observation"
         ]
        },
        "automatically_scored": {
         "type": "boolean",
         "enum": [
          false
         ]
        }
       }
      }
     }
    },
    "success_rule": {
     "type": "string",
     "maxLength": 1200,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    }
   }
  },
  "pins": {
   "type": "array",
   "maxItems": 200,
   "items": {
    "type": "object",
    "required": [
     "item_id",
     "version"
    ],
    "properties": {
     "item_id": {
      "$ref": "id"
     },
     "version": {
      "$ref": "item_version"
     }
    }
   }
  },
  "objective_route": {
   "type": "object",
   "required": [
    "mode",
    "progress_target_ref",
    "batch_id",
    "batch_version",
    "content_state",
    "stages",
    "ready_for_runtime"
   ],
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "objective"
     ]
    },
    "progress_target_ref": {
     "$ref": "id"
    },
    "batch_id": {
     "$ref": "id"
    },
    "batch_version": {
     "$ref": "item_version"
    },
    "content_state": {
     "$ref": "pack_token"
    },
    "stages": {
     "type": "object",
     "required": [
      "exact",
      "similar",
      "generic"
     ],
     "properties": {
      "exact": {
       "$ref": "pins"
      },
      "similar": {
       "$ref": "pins"
      },
      "generic": {
       "$ref": "pins"
      }
     }
    },
    "ready_for_runtime": {
     "type": "boolean"
    }
   }
  },
  "external_route": {
   "type": "object",
   "required": [
    "mode",
    "plan"
   ],
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "external"
     ]
    },
    "plan": {
     "$ref": "plan"
    }
   }
  },
  "register_case": {
   "type": "object",
   "required": [
    "id",
    "target",
    "observation_type",
    "review_status",
    "cause",
    "source_interpretation_uncertain",
    "correction_status",
    "route"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^O[0-9]{3}$"
    },
    "target": {
     "$ref": "case_text"
    },
    "observation_type": {
     "type": "string",
     "enum": [
      "character",
      "word",
      "pinyin",
      "reading",
      "writing",
      "speaking"
     ]
    },
    "review_status": {
     "type": "string",
     "enum": [
      "parent_accepted"
     ]
    },
    "cause": {
     "$ref": "short_text"
    },
    "source_interpretation_uncertain": {
     "type": "boolean"
    },
    "correction_status": {
     "$ref": "short_text"
    },
    "route": {
     "anyOf": [
      {
       "$ref": "objective_route"
      },
      {
       "$ref": "external_route"
      }
     ]
    },
    "production_followup": {
     "$ref": "plan"
    }
   }
  },
  "pack_item": {
   "type": "object",
   "required": [
    "id",
    "version",
    "courses",
    "target_refs",
    "family",
    "format",
    "stem",
    "options",
    "correct_option_id",
    "hint",
    "explanation",
    "material_id",
    "stage",
    "blanks",
    "annotations",
    "blank_ref"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "courses": {
     "$ref": "pack_courses"
    },
    "outcome_refs": {
     "$ref": "ref_list"
    },
    "target_refs": {
     "$ref": "ref_list"
    },
    "repair_target_refs": {
     "type": "array",
     "nullable": true,
     "maxItems": 64,
     "items": {
      "$ref": "id"
     }
    },
    "family": {
     "$ref": "pack_token"
    },
    "format": {
     "type": "string",
     "enum": [
      "mcq_4plus"
     ]
    },
    "stem": {
     "type": "string",
     "maxLength": 600,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "options": {
     "type": "array",
     "maxItems": 12,
     "items": {
      "type": "object",
      "required": [
       "id",
       "text"
      ],
      "properties": {
       "id": {
        "$ref": "option_id"
       },
       "text": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
        "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
       }
      }
     }
    },
    "correct_option_id": {
     "$ref": "option_id"
    },
    "hint": {
     "type": "string",
     "maxLength": 400,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "explanation": {
     "type": "string",
     "maxLength": 800,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "material_id": {
     "$ref": "nullable_id"
    },
    "stage": {
     "type": "string",
     "nullable": true,
     "enum": [
      "exact",
      "similar",
      "generic"
     ]
    },
    "asset_refs": {
     "$ref": "ref_list"
    },
    "blanks": {
     "$ref": "blanks"
    },
    "annotations": {
     "$ref": "annotations"
    },
    "blank_ref": {
     "type": "string",
     "nullable": true,
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$"
    }
   }
  },
  "pack_material": {
   "type": "object",
   "required": [
    "id",
    "version",
    "courses",
    "kind",
    "title",
    "body",
    "question_ids",
    "blanks",
    "annotations"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "courses": {
     "$ref": "pack_courses"
    },
    "kind": {
     "$ref": "pack_token"
    },
    "title": {
     "type": "string",
     "maxLength": 120,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "body": {
     "type": "string",
     "maxLength": 4000,
     "pattern": "^[^\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "question_ids": {
     "$ref": "ref_list"
    },
    "blanks": {
     "$ref": "blanks"
    },
    "annotations": {
     "$ref": "annotations"
    },
    "outcome_refs": {
     "$ref": "ref_list"
    },
    "asset_refs": {
     "$ref": "ref_list"
    }
   }
  },
  "pack_group": {
   "type": "object",
   "required": [
    "id",
    "target_refs",
    "item_ids"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "label_zh": {
     "type": "string",
     "maxLength": 64,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "label_en": {
     "type": "string",
     "maxLength": 120,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "courses": {
     "$ref": "pack_courses"
    },
    "target_refs": {
     "type": "array",
     "maxItems": 400,
     "items": {
      "$ref": "id"
     }
    },
    "item_ids": {
     "type": "array",
     "maxItems": 1000,
     "items": {
      "$ref": "id"
     }
    }
   }
  },
  "pack_batch": {
   "type": "object",
   "required": [
    "batch_id",
    "version",
    "status",
    "curriculum_manifest_version",
    "materials",
    "items",
    "groups"
   ],
   "properties": {
    "batch_id": {
     "$ref": "id"
    },
    "version": {
     "$ref": "item_version"
    },
    "status": {
     "$ref": "pack_token"
    },
    "curriculum_manifest_version": {
     "$ref": "pack_token"
    },
    "review_characters_version": {
     "$ref": "pack_token"
    },
    "materials": {
     "type": "array",
     "maxItems": 500,
     "items": {
      "$ref": "pack_material"
     }
    },
    "items": {
     "type": "array",
     "maxItems": 3000,
     "items": {
      "$ref": "pack_item"
     }
    },
    "groups": {
     "type": "array",
     "maxItems": 500,
     "items": {
      "$ref": "pack_group"
     }
    }
   }
  },
  "private_target": {
   "type": "object",
   "required": [
    "id",
    "course",
    "kind",
    "label_zh",
    "assessed_skill"
   ],
   "properties": {
    "id": {
     "$ref": "id"
    },
    "course": {
     "$ref": "pack_course"
    },
    "outcome_ref": {
     "$ref": "id"
    },
    "kind": {
     "type": "string",
     "enum": [
      "word",
      "language_point",
      "reading_skill"
     ]
    },
    "label_zh": {
     "type": "string",
     "maxLength": 64,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    },
    "assessed_skill": {
     "$ref": "short_text"
    },
    "word": {
     "type": "string",
     "maxLength": 24,
     "pattern": "^[^\\r\\n\\t\\u0001-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
     "notPattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]"
    }
   }
  },
  "pack": {
   "type": "object",
   "required": [
    "schema_version",
    "pack_id",
    "course",
    "register",
    "corrective_batches",
    "private_targets"
   ],
   "properties": {
    "schema_version": {
     "type": "string",
     "enum": [
      "turtle-private-pack/1"
     ]
    },
    "pack_id": {
     "$ref": "id"
    },
    "course": {
     "type": "string",
     "enum": [
      "p2_chinese",
      "p2_higher_chinese"
     ]
    },
    "register": {
     "type": "object",
     "required": [
      "schema_version",
      "register_id",
      "course",
      "policy",
      "review_complete",
      "cases"
     ],
     "properties": {
      "schema_version": {
       "type": "string",
       "enum": [
        "anonymous-mistake-register/1"
       ]
      },
      "register_id": {
       "$ref": "id"
      },
      "course": {
       "type": "string",
       "enum": [
        "p2_chinese",
        "p2_higher_chinese"
       ]
      },
      "policy": {
       "$ref": "short_text"
      },
      "review_complete": {
       "type": "boolean",
       "enum": [
        true
       ]
      },
      "cases": {
       "type": "array",
       "maxItems": 2000,
       "items": {
        "$ref": "register_case"
       }
      }
     }
    },
    "corrective_batches": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "$ref": "pack_batch"
     }
    },
    "private_targets": {
     "type": "array",
     "maxItems": 2000,
     "items": {
      "$ref": "private_target"
     }
    }
   }
  }
 },
 "kinds": {
  "pack_version": {
   "class": "add_only",
   "key": "version_ref",
   "value": {
    "type": "object",
    "required": [
     "version_ref",
     "pack"
    ],
    "properties": {
     "version_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}@[0-9a-f]{16}$"
     },
     "pack": {
      "$ref": "pack"
     }
    }
   }
  },
  "active_pack": {
   "class": "editable",
   "key": "active",
   "value": {
    "type": "object",
    "required": [
     "version_ref"
    ],
    "properties": {
     "version_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}@[0-9a-f]{16}$"
     }
    }
   }
  },
  "case_link": {
   "class": "editable",
   "key": "case_id",
   "deletable": true,
   "value": {
    "type": "object",
    "required": [
     "case_id",
     "mode",
     "target_ref",
     "engine_target_id",
     "plan_id",
     "shared_with"
    ],
    "properties": {
     "case_id": {
      "type": "string",
      "pattern": "^O[0-9]{3}$"
     },
     "mode": {
      "type": "string",
      "enum": [
       "objective",
       "external"
      ]
     },
     "target_ref": {
      "$ref": "nullable_id"
     },
     "engine_target_id": {
      "$ref": "nullable_id"
     },
     "plan_id": {
      "type": "string",
      "nullable": true,
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,160}$"
     },
     "shared_with": {
      "type": "array",
      "maxItems": 2000,
      "items": {
       "type": "string",
       "pattern": "^O[0-9]{3}$"
      }
     }
    }
   }
  },
  "production_event": {
   "class": "add_only",
   "key": "id",
   "value": {
    "type": "object",
    "required": [
     "id",
     "plan_id",
     "stage",
     "observed_on",
     "mode",
     "result",
     "recorded_at"
    ],
    "properties": {
     "id": {
      "$ref": "id"
     },
     "plan_id": {
      "$ref": "plan_id"
     },
     "stage": {
      "type": "string",
      "enum": [
       "exact",
       "similar",
       "generic",
       "delayed_review"
      ]
     },
     "observed_on": {
      "$ref": "date"
     },
     "mode": {
      "type": "string",
      "enum": [
       "independent",
       "supported"
      ]
     },
     "result": {
      "type": "string",
      "enum": [
       "correct",
       "not_yet"
      ]
     },
     "recorded_at": {
      "$ref": "datetime"
     }
    }
   }
  }
 }
}
