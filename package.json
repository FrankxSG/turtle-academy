{
  "name": "turtle-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-icons.mjs && tsc --noEmit && vite build",
    "build:hosted": "if [ \"$TURTLE_SITE\" = \"trials\" ]; then npm run build:trials && rm -rf dist && cp -R trials/dist dist; else npm run build; fi",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "dev:trials": "vite --config vite.trials.config.ts --host 127.0.0.1",
    "build:trials": "tsc --noEmit && vite build --config vite.trials.config.ts",
    "preview:trials": "vite preview --config vite.trials.config.ts --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:ui": "node --experimental-strip-types --test tests/ui/*.test.ts",
    "test:engine": "node --experimental-strip-types --test tests/engine/*.test.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  }
}
