    },
    {
      "id": "zh-m05",
      "version": 1,
      "courses": [
        "p3_chinese",
        "p3_higher_chinese"
      ],
      "kind": "reading",
      "title": "换一个办法",
      "body": "学校的图书角要增加一个放书的地方。小宁想用纸盒做书架，可是大纸盒太软，放进几本书就倒了。她和伙伴把书拿出来，在盒子里加了两块硬纸板，再把较重的书放在下面。这次，纸盒站稳了。伙伴说：“先试一试，再改一改，真有用！”",
      "question_ids": [
        "zh-m05.q1",
        "zh-m05.q2",
        "zh-m05.q3",
        "zh-m05.q4",
        "zh-m05.q5"
      ],
      "feedback_policy": "after_all_first_responses",
